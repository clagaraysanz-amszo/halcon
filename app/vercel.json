{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "crons": [
    {
      "path": "/api/bitacora/cron",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/onedrive/monthly-rollover",
      "schedule": "5 3 1 * *"
    },
    {
      "path": "/api/onedrive/restore-active-file",
      "schedule": "0 0 30 2 *"
    }
  ],
  "functions": {
    "api/onedrive/*.js": {
      "maxDuration": 60
    }
  }
}
